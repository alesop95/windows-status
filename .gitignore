# =============================================================================
#  windows-status — .gitignore
#  Versioni gli SCRIPT e i DOCUMENTI (la tua IP). NON versioni per default le
#  fotografie dello stato: contengono dettagli specifici della macchina.
# =============================================================================

# Output degli snapshot (dati specifici della macchina/account)
snapshots/*
!snapshots/LEGGIMI.txt

# Segreti — non devono MAI finire nel repo (specie se diventa pubblico)
*.credentials.json
.credentials.json
*.env
.env
*.key
*.pem
*.pfx
id_rsa
id_ed25519
id_ecdsa
known_hosts
secrets*
*token*
*.secret

# Copie "compilate" dei documenti con dati reali della macchina (mai nel repo pubblico)
docs/*.compilata.md

# Sistema
Thumbs.db
desktop.ini
*.tmp

# --- Sistema di progetto portabile: livello privato e ignorato ---
# Livello privato e verboso
_notes/

# Override personali e permessi personali
CLAUDE.local.md
.claude/settings.local.json

# Estratti temporanei dei .docx (cartelle scratch)
.tmp-docx-*/
_notes/.tmp-docx-*/

# Documenti Word grezzi (binari); dichiarare qui eventuali eccezioni curate
*.docx
